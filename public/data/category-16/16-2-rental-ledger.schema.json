{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rmworld.rise-mitra.internal/schemas/category-16/16-2-rental-ledger.schema.json",
  "title": "Rise Mitra Sub-Feature 16-2 Rental Ledger Schema",
  "description": "Validation schema for Rental Ledger configuration, sub-meter readings, ledger vouchers, and v0.7 unit publication governance under Universal Catalog standard.",
  "type": "object",
  "required": [
    "subFeatureId",
    "categoryId",
    "featureSlug",
    "moduleVersion",
    "schemaVersion",
    "bundleVersion",
    "storageContract",
    "cacheBundle",
    "configurationDefaults",
    "publicationPolicies",
    "properties",
    "i18n",
    "auditTrail"
  ],
  "properties": {
    "subFeatureId": {
      "type": "string",
      "const": "16-2"
    },
    "categoryId": {
      "type": "string",
      "const": "category-16"
    },
    "featureSlug": {
      "type": "string",
      "const": "rental-ledger"
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "bundleVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "landlordId": {
      "type": "string",
      "pattern": "^LL-[A-Z0-9]{8,12}$"
    },
    "storageContract": {
      "type": "object",
      "required": ["localNamespaceTemplate", "cacheBundleTemplate"],
      "properties": {
        "localNamespaceTemplate": { "type": "string" },
        "cacheBundleTemplate": { "type": "string" }
      }
    },
    "cacheBundle": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "configurationDefaults": {
      "type": "object",
      "required": [
        "currency",
        "currencySymbol",
        "defaultDueDayOfMonth",
        "electricitySubMeter"
      ],
      "properties": {
        "currency": { "type": "string", "maxLength": 3, "default": "INR" },
        "currencySymbol": { "type": "string", "default": "₹" },
        "defaultDueDayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31, "default": 5 },
        "gracePeriodDays": { "type": "integer", "minimum": 0, "default": 5 },
        "electricitySubMeter": {
          "type": "object",
          "required": ["enabled", "defaultRatePerUnit"],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "defaultRatePerUnit": { "type": "number", "minimum": 0, "default": 8.0 },
            "meterReadingFrequency": { "type": "string", "enum": ["MONTHLY", "BI_MONTHLY"], "default": "MONTHLY" }
          }
        },
        "waterCharges": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["FIXED_MONTHLY", "PER_PERSON", "ACTUAL", "INCLUDED"], "default": "FIXED_MONTHLY" },
            "defaultAmount": { "type": "number", "minimum": 0, "default": 0 }
          }
        },
        "maintenanceCharges": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["FIXED_MONTHLY", "INCLUDED"], "default": "FIXED_MONTHLY" },
            "defaultAmount": { "type": "number", "minimum": 0, "default": 0 }
          }
        },
        "securityDeposit": {
          "type": "object",
          "properties": {
            "tracked": { "type": "boolean", "default": true },
            "interestBearing": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "publicationPolicies": {
      "type": "object",
      "required": ["globalDefaultMode", "autoPublishAllowed"],
      "properties": {
        "globalDefaultMode": {
          "type": "string",
          "enum": ["private_only", "confirm_each_time", "auto_publish"],
          "default": "confirm_each_time"
        },
        "autoPublishAllowed": { "type": "boolean", "default": false },
        "lastConsentTimestamp": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "landlordProfile": {
      "type": "object",
      "required": ["name", "maskedPhone"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "maskedPhone": { "type": "string", "pattern": "^\\+91\\s[X]{5}[0-9]{5}$" },
        "emergencyContact": { "type": "string" }
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "propertyId",
          "title",
          "propertyType",
          "address",
          "units"
        ],
        "properties": {
          "propertyId": { "type": "string", "pattern": "^PROP-[0-9]{4,8}$" },
          "title": { "type": "string", "minLength": 3 },
          "propertyType": {
            "type": "string",
            "enum": ["independent_house", "apartment_flat", "pg_hostel", "commercial_shop"]
          },
          "address": {
            "type": "object",
            "required": ["city", "locality", "pincode"],
            "properties": {
              "fullAddressPrivate": { "type": "string" },
              "city": { "type": "string" },
              "locality": { "type": "string" },
              "pincode": { "type": "string", "pattern": "^[0-9]{6}$" }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/rentalUnit"
            }
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "required": ["hi", "en"],
      "properties": {
        "hi": { "$ref": "#/definitions/localeStrings" },
        "en": { "$ref": "#/definitions/localeStrings" }
      }
    },
    "auditTrail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "timestamp", "actorRole", "actionType"],
        "properties": {
          "eventId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "actorRole": { "type": "string", "enum": ["owner", "landlord", "manager", "system"] },
          "actionType": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "localeStrings": {
      "type": "object",
      "required": ["featureTitle", "actions", "labels", "disclaimer"],
      "properties": {
        "featureTitle": { "type": "string" },
        "featureSubtitle": { "type": "string" },
        "actions": { "type": "object" },
        "labels": { "type": "object" },
        "disclaimer": { "type": "string" }
      }
    },
    "voucherRecord": {
      "type": "object",
      "required": [
        "voucherId",
        "accountRef",
        "unitIdentifier",
        "billingMonth",
        "rentAmount",
        "unitsConsumed",
        "electricityAmount",
        "netPayable",
        "paymentStatus",
        "timestamp"
      ],
      "properties": {
        "voucherId": { "type": "string" },
        "accountRef": { "type": "string" },
        "unitIdentifier": { "type": "string" },
        "billingMonth": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "rentAmount": { "type": "number", "minimum": 0 },
        "previousMeterReading": { "type": "number", "minimum": 0 },
        "currentMeterReading": { "type": "number", "minimum": 0 },
        "unitsConsumed": { "type": "number", "minimum": 0 },
        "electricityAmount": { "type": "number", "minimum": 0 },
        "otherCharges": { "type": "number", "default": 0 },
        "netPayable": { "type": "number", "minimum": 0 },
        "paymentStatus": {
          "type": "string",
          "enum": ["PENDING", "RECORDED_UNVERIFIED", "ACKNOWLEDGED", "SETTLED"]
        },
        "digitalSlipRef": { "type": "string" },
        "timestamp": { "type": "integer" }
      }
    },
    "rentalUnit": {
      "type": "object",
      "required": [
        "unitId",
        "unitLabel",
        "unitType",
        "monthlyRent",
        "securityDeposit",
        "publicationSettings",
        "lifecycleStatus",
        "activeTenancy"
      ],
      "properties": {
        "unitId": { "type": "string", "pattern": "^UNIT-[0-9]{4,8}$" },
        "unitLabel": { "type": "string" },
        "unitType": {
          "type": "string",
          "enum": ["entire_flat", "private_room", "shared_bed"]
        },
        "monthlyRent": { "type": "number", "minimum": 0 },
        "securityDeposit": { "type": "number", "minimum": 0 },
        "electricityConfig": {
          "type": "object",
          "required": ["meterType"],
          "properties": {
            "meterType": {
              "type": "string",
              "enum": ["sub_meter_per_unit", "included_in_rent", "fixed_monthly", "commercial_direct"]
            },
            "ratePerUnit": { "type": "number", "minimum": 0, "default": 8.0 },
            "lastReading": { "type": "number", "minimum": 0, "default": 0 },
            "lastReadingDate": { "type": ["string", "null"], "format": "date" }
          }
        },
        "publicationSettings": {
          "type": "object",
          "required": ["mode", "consentActive", "isListedPublicly"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["private_only", "confirm_each_time", "auto_publish"],
              "default": "confirm_each_time"
            },
            "consentActive": { "type": "boolean", "default": false },
            "isListedPublicly": { "type": "boolean", "default": false },
            "targetCategory": { "type": "string", "const": "16-3" },
            "publicPriceSnapshot": { "type": "number", "minimum": 0 }
          }
        },
        "lifecycleStatus": {
          "type": "object",
          "required": [
            "physicalPossessionReturned",
            "readyToRent",
            "settlementPending"
          ],
          "properties": {
            "physicalPossessionReturned": { "type": "boolean", "default": false },
            "readyToRent": { "type": "boolean", "default": false },
            "settlementPending": { "type": "boolean", "default": false },
            "keysHandedOverDate": { "type": ["string", "null"], "format": "date" },
            "futureAvailableDate": { "type": ["string", "null"], "format": "date" }
          }
        },
        "activeTenancy": {
          "type": ["object", "null"],
          "properties": {
            "tenancyId": { "type": "string", "pattern": "^TEN-[0-9]{4,8}$" },
            "tenantName": { "type": "string" },
            "tenantMaskedPhone": { "type": "string" },
            "startDate": { "type": "string", "format": "date" },
            "arrearsDue": { "type": "number", "default": 0 },
            "advancePaid": { "type": "number", "default": 0 }
          }
        },
        "pastTenancies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tenancyId", "exitDate", "finalSettled"],
            "properties": {
              "tenancyId": { "type": "string" },
              "exitDate": { "type": "string", "format": "date" },
              "unpaidBalance": { "type": "number", "default": 0 },
              "refundDue": { "type": "number", "default": 0 },
              "finalSettled": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
