{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rmworld.rise-mitra.internal/schemas/category-16/16-2-rental-ledger.schema.json",
  "title": "Rise Mitra Sub-Feature 16-2 Rental Ledger Schema",
  "description": "Validation schema for Rental Ledger configuration, sub-meter readings, and ledger vouchers under Universal Catalog standard.",
  "type": "object",
  "required": [
    "subFeatureId",
    "categoryId",
    "featureSlug",
    "moduleVersion",
    "schemaVersion",
    "bundleVersion",
    "storageContract",
    "cacheBundle",
    "configurationDefaults",
    "i18n"
  ],
  "properties": {
    "subFeatureId": {
      "type": "string",
      "const": "16-2"
    },
    "categoryId": {
      "type": "string",
      "const": "category-16"
    },
    "featureSlug": {
      "type": "string",
      "const": "rental-ledger"
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "bundleVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "storageContract": {
      "type": "object",
      "required": ["localNamespaceTemplate", "cacheBundleTemplate"],
      "properties": {
        "localNamespaceTemplate": { "type": "string" },
        "cacheBundleTemplate": { "type": "string" }
      }
    },
    "cacheBundle": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "configurationDefaults": {
      "type": "object",
      "required": [
        "currency",
        "currencySymbol",
        "defaultDueDayOfMonth",
        "electricitySubMeter"
      ],
      "properties": {
        "currency": { "type": "string", "maxLength": 3 },
        "currencySymbol": { "type": "string" },
        "defaultDueDayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31 },
        "gracePeriodDays": { "type": "integer", "minimum": 0 },
        "electricitySubMeter": {
          "type": "object",
          "required": ["enabled", "defaultRatePerUnit"],
          "properties": {
            "enabled": { "type": "boolean" },
            "defaultRatePerUnit": { "type": "number", "minimum": 0 },
            "meterReadingFrequency": { "type": "string", "enum": ["MONTHLY", "BI_MONTHLY"] }
          }
        },
        "waterCharges": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["FIXED_MONTHLY", "PER_PERSON", "ACTUAL"] },
            "defaultAmount": { "type": "number", "minimum": 0 }
          }
        },
        "maintenanceCharges": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["FIXED_MONTHLY", "INCLUDED"] },
            "defaultAmount": { "type": "number", "minimum": 0 }
          }
        },
        "securityDeposit": {
          "type": "object",
          "properties": {
            "tracked": { "type": "boolean" },
            "interestBearing": { "type": "boolean" }
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "required": ["hi", "en"],
      "properties": {
        "hi": { "$ref": "#/definitions/localeStrings" },
        "en": { "$ref": "#/definitions/localeStrings" }
      }
    }
  },
  "definitions": {
    "localeStrings": {
      "type": "object",
      "required": ["featureTitle", "actions", "labels", "disclaimer"],
      "properties": {
        "featureTitle": { "type": "string" },
        "featureSubtitle": { "type": "string" },
        "actions": { "type": "object" },
        "labels": { "type": "object" },
        "disclaimer": { "type": "string" }
      }
    },
    "voucherRecord": {
      "type": "object",
      "required": [
        "voucherId",
        "accountRef",
        "unitIdentifier",
        "billingMonth",
        "rentAmount",
        "unitsConsumed",
        "electricityAmount",
        "netPayable",
        "paymentStatus",
        "timestamp"
      ],
      "properties": {
        "voucherId": { "type": "string" },
        "accountRef": { "type": "string" },
        "unitIdentifier": { "type": "string" },
        "billingMonth": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "rentAmount": { "type": "number", "minimum": 0 },
        "previousMeterReading": { "type": "number", "minimum": 0 },
        "currentMeterReading": { "type": "number", "minimum": 0 },
        "unitsConsumed": { "type": "number", "minimum": 0 },
        "electricityAmount": { "type": "number", "minimum": 0 },
        "otherCharges": { "type": "number", "default": 0 },
        "netPayable": { "type": "number", "minimum": 0 },
        "paymentStatus": {
          "type": "string",
          "enum": ["PENDING", "RECORDED_UNVERIFIED", "ACKNOWLEDGED", "SETTLED"]
        },
        "digitalSlipRef": { "type": "string" },
        "timestamp": { "type": "integer" }
      }
    }
  }
}
